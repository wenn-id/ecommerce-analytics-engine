# Backend API endpoint for server-side proxy
BACKEND_API_URL=http://localhost:8080/api/v1
# Optional server-side API Key for authenticating with Go backend (never
# exposed to browser). Must match the backend's API_KEY. When unset, requests
# are proxied without a key (backend keyless/dev mode) — a browser-supplied
# key is never forwarded.
API_KEY=
