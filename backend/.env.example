# Server
PORT=8080
DB_PATH=analytics.db
SYNC_INTERVAL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication
# Shared API key required on every endpoint when set. Required (non-empty)
# whenever APP_ENV=production; development defaults to keyless mode.
API_KEY=
APP_ENV=development

# Proxy & rate limiting
# Comma-separated IPs/CIDRs whose X-Forwarded-For/X-Real-IP headers are
# trusted when resolving real client IPs. Empty = loopback only.
# Docker deployments: TRUSTED_PROXY_CIDRS=127.0.0.1/8,::1/128,172.16.0.0/12
TRUSTED_PROXY_CIDRS=

# Observability
# LOG_FORMAT=text|json
LOG_FORMAT=text

# --- Real platform connectors (#62) ---------------------------------------
# Each channel uses its real API connector when its credentials are set and
# falls back to the deterministic mock connector otherwise (check startup
# logs for the chosen mode per channel).

# Meta Ads (Marketing API)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
#META_API_BASE=https://graph.facebook.com
#META_API_VERSION=v19.0

# TikTok Ads (Business API v1.3)
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
#TIKTOK_API_BASE=https://business-api.tiktok.com

# Shopee (Open Platform v2)
# SHOPEE_ACCESS_TOKEN comes from the shop OAuth authorization flow.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ACCESS_TOKEN=
SHOPEE_SHOP_ID=
#SHOPEE_API_BASE=https://openplatform.shopee.com
# Comma-separated Shopee Ads campaign ids to sync (no list-all endpoint).
SHOPEE_CAMPAIGN_IDS=
